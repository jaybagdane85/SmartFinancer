<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salary Breakdown"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#4285F4"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Basic Salary"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tv_basic_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹30,000"
            android:textColor="#000000"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HRA"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tv_hra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹12,000"
            android:textColor="#000000"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Special Allowance"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tv_special_allowance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹8,000"
            android:textColor="#000000"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gross Salary"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_gross_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹50,000"
            android:textColor="#4CAF50"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PF Deduction"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tv_pf_deduction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹3,600"
            android:textColor="#F44336"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Income Tax"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/tv_income_tax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹5,000"
            android:textColor="#F44336"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Net Salary"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_net_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹41,400"
            android:textColor="#4285F4"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>

